<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classroom Gradebook & Attendance Manager</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .grade-input:focus {
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5);
        }
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col md:flex-row antialiased selection:bg-brand-500 selection:text-white">

    <!-- Navigation Sidebar -->
    <aside class="w-full md:w-64 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col no-print border-r border-slate-800 z-20">
        <!-- Brand Header -->
        <div class="p-5 flex items-center justify-between border-b border-slate-800">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-brand-500/30">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="font-bold text-white text-lg tracking-tight leading-tight">MLQHSSID</h1>
                    <span class="text-xs text-slate-400">Teacher Management</span>
                </div>
            </div>
        </div>

        <!-- Sync Status Card -->
        <div class="p-4 border-b border-slate-800/80 bg-gradient-to-b from-emerald-600/10 to-slate-950/40">
            <div class="bg-emerald-600/20 border border-emerald-500/30 rounded-lg p-3">
                <p class="text-xs font-semibold text-emerald-300 flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-cloud-check text-emerald-400"></i> Cloud Sync Ready
                </p>
                <p class="text-[10px] text-emerald-200 mb-3">Share your class with other devices</p>
                <button onclick="openModal('shareSyncModal')" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold py-1.5 px-3 rounded-lg border border-emerald-500 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-share-nodes"></i> Share Class Code
                </button>
            </div>
        </div>

        <!-- Class Selector Card -->
        <div class="p-4 border-b border-slate-800/80 bg-slate-950/40">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Active Class</label>
            <select id="classSelect" onchange="switchClass(this.value)" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand-500">
            </select>
            <button onclick="openModal('newClassModal')" class="mt-2 w-full text-xs bg-slate-800 hover:bg-slate-700 text-brand-400 hover:text-brand-300 font-medium py-1.5 px-3 rounded border border-slate-700">
                <i class="fa-solid fa-plus text-xs"></i> Create New Class
            </button>
        </div>

        <!-- Primary Nav Links -->
        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
            <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition text-white bg-brand-600 hover:bg-brand-700">
                <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                <span>Dashboard</span>
            </button>
            <button onclick="switchTab('students')" id="nav-students" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800">
                <i class="fa-solid fa-users w-5 text-center"></i>
                <span>Student Roster</span>
                <span id="navStudentCount" class="ml-auto bg-slate-800 text-slate-300 text-xs px-2 py-0.5 rounded-full">0</span>
            </button>
            <button onclick="switchTab('settings')" id="nav-settings" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800">
                <i class="fa-solid fa-sliders w-5 text-center"></i>
                <span>Settings & Backup</span>
            </button>
        </nav>

        <!-- Quick Actions -->
        <div class="p-4 border-t border-slate-800 space-y-2">
            <button onclick="loadSampleData()" class="w-full bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600/30 font-medium py-2 px-3 text-xs rounded-lg border border-emerald-500/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Load Demo Data
            </button>
            <div class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-800/60">
                <span>Data Saved Locally</span>
                <i class="fa-solid fa-check-circle text-emerald-500"></i>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top Navbar -->
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 no-print shadow-sm z-10">
            <div>
                <div class="flex items-center gap-2">
                    <h2 id="currentClassName" class="text-xl font-bold text-slate-900">Loading...</h2>
                    <span id="currentClassSubject" class="text-xs bg-slate-100 text-slate-600 font-semibold px-2.5 py-1 rounded-full border border-slate-200">--</span>
                </div>
                <p id="currentClassMeta" class="text-xs text-slate-500 mt-0.5">Manage your classroom</p>
            </div>
            <div class="flex items-center flex-wrap gap-2">
                <button onclick="openModal('newStudentModal')" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3 py-2 rounded-lg border border-slate-300 flex items-center gap-1.5">
                    <i class="fa-solid fa-user-plus"></i> Add Student
                </button>
            </div>
        </header>

        <!-- Main Body Viewport -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50">

            <!-- TAB 1: DASHBOARD -->
            <section id="tab-dashboard" class="tab-content space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Total Students</p>
                            <h3 id="dashTotalStudents" class="text-2xl font-bold text-slate-800">0</h3>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-book"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Total Classes</p>
                            <h3 id="dashTotalClasses" class="text-2xl font-bold text-slate-800">0</h3>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Data Sync</p>
                            <h3 id="dashSyncStatus" class="text-2xl font-bold text-slate-800">Ready</h3>
                            <p class="text-[11px] text-slate-400">Use share codes</p>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-info-circle"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Browser Storage</p>
                            <h3 id="dashStorageUsage" class="text-2xl font-bold text-slate-800">Local</h3>
                            <p class="text-[11px] text-slate-400">Works offline</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                    <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-lightbulb text-amber-500"></i> How Cross-Device Sync Works
                    </h3>
                    <div class="space-y-3 text-sm text-slate-600">
                        <div class="flex gap-3">
                            <div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">1</div>
                            <div>
                                <p class="font-semibold text-slate-800">Create/Edit Class</p>
                                <p class="text-xs text-slate-500 mt-1">Add students and data on this device</p>
                            </div>
                        </div>
                        <div class="flex gap-3">
                            <div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">2</div>
                            <div>
                                <p class="font-semibold text-slate-800">Generate Share Code</p>
                                <p class="text-xs text-slate-500 mt-1">Click "Share Class Code" to get a unique code</p>
                            </div>
                        </div>
                        <div class="flex gap-3">
                            <div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">3</div>
                            <div>
                                <p class="font-semibold text-slate-800">Use on Another Device</p>
                                <p class="text-xs text-slate-500 mt-1">Paste the code on phone/computer to access the same class</p>
                            </div>
                        </div>
                        <div class="flex gap-3">
                            <div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">4</div>
                            <div>
                                <p class="font-semibold text-slate-800">Backup to Google Sheets</p>
                                <p class="text-xs text-slate-500 mt-1">Export grades to CSV, upload to Google Sheets for safety</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TAB 2: STUDENT ROSTER -->
            <section id="tab-students" class="tab-content hidden space-y-6">
                <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="relative w-full sm:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" id="studentSearchInput" onkeyup="renderStudentRoster()" placeholder="Search student..." class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                    </div>
                    <button onclick="openModal('newStudentModal')" class="px-3.5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-user-plus"></i> Add Student
                    </button>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3.5 px-4">ID</th>
                                    <th class="py-3.5 px-4">Name</th>
                                    <th class="py-3.5 px-4">Gender</th>
                                    <th class="py-3.5 px-4 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="studentTableBody" class="divide-y divide-slate-100 text-sm">
                            </tbody>
                        </table>
                    </div>
                    <div id="studentTableEmpty" class="hidden p-8 text-center text-slate-400">
                        <i class="fa-solid fa-user-slash text-4xl mb-2 opacity-50"></i>
                        <p>No students yet</p>
                    </div>
                </div>
            </section>

            <!-- TAB 3: SETTINGS & BACKUP -->
            <section id="tab-settings" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Class Settings -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                        <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-cog text-slate-600"></i> Class Settings
                        </h3>
                        <form id="classSettingsForm" onsubmit="saveClassSettings(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Class Name</label>
                                <input type="text" id="setClassName" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Subject</label>
                                <input type="text" id="setClassSubject" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                            </div>
                            <div class="pt-4 flex gap-2">
                                <button type="submit" class="flex-1 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg">Save Changes</button>
                                <button type="button" onclick="confirmDeleteClass()" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold rounded-lg border border-rose-200">Delete</button>
                            </div>
                        </form>
                    </div>

                    <!-- Backup & Export -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                        <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-database text-emerald-600"></i> Backup & Export
                        </h3>
                        <div class="space-y-3">
                            <button onclick="exportDataAsJSON()" class="w-full px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-2">
                                <i class="fa-solid fa-file-export"></i> Export as JSON
                            </button>
                            <button onclick="exportDataAsCSV()" class="w-full px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-2">
                                <i class="fa-solid fa-file-csv"></i> Export as CSV
                            </button>
                            <button onclick="openModal('importDataModal')" class="w-full px-4 py-2 bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-2">
                                <i class="fa-solid fa-file-import"></i> Import Data
                            </button>
                            <p class="text-[11px] text-slate-500 text-center mt-3">💡 Export regularly to backup on Google Sheets</p>
                        </div>
                    </div>
                </div>

                <!-- Data Storage Info -->
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
                    <h3 class="font-bold text-blue-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-circle-info"></i> Data Storage
                    </h3>
                    <ul class="text-xs text-blue-800 space-y-1">
                        <li>✓ All data stored locally in your browser (IndexedDB)</li>
                        <li>✓ Works completely offline</li>
                        <li>✓ Data never leaves your device unless you export it</li>
                        <li>✓ Clear browser data = clear app storage</li>
                    </ul>
                </div>
            </section>

        </main>
    </div>

    <!-- MODAL: Share Class Code -->
    <div id="shareSyncModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-800">Share Class Code</h3>
                <button onclick="closeModal('shareSyncModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="space-y-4">
                <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4">
                    <p class="text-xs font-semibold text-emerald-900 mb-2">Your Class Code</p>
                    <div class="bg-white border-2 border-emerald-600 rounded-lg p-3 font-mono text-sm font-bold text-slate-800 text-center">
                        <span id="shareCodeDisplay">LOADING...</span>
                    </div>
                </div>
                <p class="text-xs text-slate-600">
                    Share this code with anyone who needs to access this class on another device. They'll paste it to load the same data.
                </p>
                <div class="flex gap-2">
                    <button onclick="copyShareCode()" class="flex-1 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg flex items-center justify-center gap-2">
                        <i class="fa-solid fa-copy"></i> Copy Code
                    </button>
                    <button onclick="closeModal('shareSyncModal')" class="flex-1 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg">Done</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: Add Student -->
    <div id="newStudentModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-800">Add New Student</h3>
                <button onclick="closeModal('newStudentModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form onsubmit="handleCreateStudent(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Student ID</label>
                    <input type="text" id="newStudentNumber" placeholder="e.g. 2026-001" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">First Name *</label>
                        <input type="text" id="newStudentFirst" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Last Name *</label>
                        <input type="text" id="newStudentLast" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Gender</label>
                    <select id="newStudentGender" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeModal('newStudentModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm">Add Student</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: Create Class -->
    <div id="newClassModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-800">Create New Class</h3>
                <button onclick="closeModal('newClassModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form onsubmit="handleCreateClass(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Class Name *</label>
                    <input type="text" id="newClassName" placeholder="e.g. Grade 10 - Newton" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Subject *</label>
                    <input type="text" id="newClassSubject" placeholder="e.g. Physical Science" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand-500">
                </div>
                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeModal('newClassModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm">Create</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: Import Data -->
    <div id="importDataModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-800">Import Data</h3>
                <button onclick="closeModal('importDataModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-2">Select JSON File to Import</label>
                    <input type="file" id="importFileInput" accept=".json" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:border-brand-500">
                </div>
                <p class="text-[11px] text-slate-500">Only JSON files exported from this app are supported</p>
                <div class="flex justify-end gap-2">
                    <button onclick="closeModal('importDataModal')" class="flex-1 px-4 py-2 bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg">Cancel</button>
                    <button onclick="handleImportData()" class="flex-1 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg">Import</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none z-50">
        <i id="toastIcon" class="fa-solid fa-check-circle text-emerald-400"></i>
        <span id="toastMsg" class="text-xs font-medium">Message</span>
    </div>

    <script>
        // --- DATABASE & STORAGE ---
        let db = null;
        const DB_NAME = 'GradebookDB';
        const DB_VERSION = 1;
        const STORE_NAME = 'appData';

        function initIndexedDB() {
            return new Promise((resolve) => {
                const request = indexedDB.open(DB_NAME, DB_VERSION);
                request.onerror = () => {
                    console.error('IndexedDB failed');
                    resolve(null);
                };
                request.onsuccess = () => {
                    db = request.result;
                    resolve(db);
                };
                request.onupgradeneeded = (e) => {
                    const database = e.target.result;
                    if (!database.objectStoreNames.contains(STORE_NAME)) {
                        database.createObjectStore(STORE_NAME);
                    }
                };
            });
        }

        // --- APP STATE ---
        const DEFAULT_STATE = {
            classes: [{ id: 'cls-demo-101', name: 'Grade 10 - Newton', subject: 'Physical Science' }],
            currentClassId: 'cls-demo-101',
            students: [],
            shareCode: null
        };

        let appData = { ...DEFAULT_STATE };
        let activeTab = 'dashboard';

        // --- STORAGE ---
        function saveToStorage() {
            if (db) {
                try {
                    const transaction = db.transaction([STORE_NAME], 'readwrite');
                    transaction.objectStore(STORE_NAME).put(appData, 'mainData');
                } catch (e) {
                    console.error('Save failed:', e);
                }
            }
            try {
                localStorage.setItem('classhub_data', JSON.stringify(appData));
            } catch (e) {
                console.error('localStorage failed:', e);
            }
        }

        function loadFromStorage() {
            return new Promise((resolve) => {
                if (db) {
                    try {
                        const transaction = db.transaction([STORE_NAME], 'readonly');
                        const request = transaction.objectStore(STORE_NAME).get('mainData');
                        request.onsuccess = () => {
                            if (request.result) {
                                appData = request.result;
                                resolve();
                                return;
                            }
                            loadFromLocalStorage();
                            resolve();
                        };
                    } catch (e) {
                        loadFromLocalStorage();
                        resolve();
                    }
                } else {
                    loadFromLocalStorage();
                    resolve();
                }
            });
        }

        function loadFromLocalStorage() {
            try {
                const stored = localStorage.getItem('classhub_data');
                if (stored) appData = JSON.parse(stored);
            } catch (e) {
                console.error('Load failed:', e);
            }
        }

        // --- UI HELPERS ---
        function showToast(msg, icon = 'fa-solid fa-check-circle text-emerald-400') {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            document.getElementById('toastIcon').className = icon;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3000);
        }

        function openModal(id) {
            document.getElementById(id)?.classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id)?.classList.add('hidden');
        }

        function switchTab(name) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.add('hidden'));
            document.getElementById(`tab-${name}`)?.classList.remove('hidden');
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-white', 'bg-brand-600', 'hover:bg-brand-700');
                btn.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-slate-800');
            });
            document.getElementById(`nav-${name}`)?.classList.add('text-white', 'bg-brand-600', 'hover:bg-brand-700');
        }

        // --- CLASS MANAGEMENT ---
        function getCurrentClass() {
            return appData.classes.find(c => c.id === appData.currentClassId) || appData.classes[0];
        }

        function generateShareCode() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let code = '';
            for (let i = 0; i < 8; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return code;
        }

        function renderClassSelect() {
            const select = document.getElementById('classSelect');
            select.innerHTML = '';
            appData.classes.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = `${c.name}`;
                if (c.id === appData.currentClassId) opt.selected = true;
                select.appendChild(opt);
            });
        }

        function switchClass(classId) {
            appData.currentClassId = classId;
            saveToStorage();
            updateHeaderUI();
            updateDashboard();
            renderStudentRoster();
            showToast('Class switched');
        }

        function updateHeaderUI() {
            const currentClass = getCurrentClass();
            if (!currentClass) return;
            document.getElementById('currentClassName').textContent = currentClass.name;
            document.getElementById('currentClassSubject').textContent = currentClass.subject;
            document.getElementById('setClassName').value = currentClass.name;
            document.getElementById('setClassSubject').value = currentClass.subject;
            const count = appData.students.filter(s => s.classId === appData.currentClassId).length;
            document.getElementById('navStudentCount').textContent = count;
        }

        function handleCreateClass(e) {
            e.preventDefault();
            const newClass = {
                id: 'cls-' + Date.now(),
                name: document.getElementById('newClassName').value.trim(),
                subject: document.getElementById('newClassSubject').value.trim()
            };
            appData.classes.push(newClass);
            appData.currentClassId = newClass.id;
            appData.shareCode = null;
            saveToStorage();
            closeModal('newClassModal');
            document.getElementById('newClassName').value = '';
            renderClassSelect();
            updateHeaderUI();
            showToast('Class created!');
        }

        function handleCreateStudent(e) {
            e.preventDefault();
            const newStudent = {
                id: 'std-' + Date.now(),
                classId: appData.currentClassId,
                studentId: document.getElementById('newStudentNumber').value.trim() || `STD-${Date.now()}`,
                firstName: document.getElementById('newStudentFirst').value.trim(),
                lastName: document.getElementById('newStudentLast').value.trim(),
                fullName: `${document.getElementById('newStudentFirst').value} ${document.getElementById('newStudentLast').value}`,
                gender: document.getElementById('newStudentGender').value
            };
            appData.students.push(newStudent);
            saveToStorage();
            closeModal('newStudentModal');
            document.getElementById('newStudentFirst').value = '';
            document.getElementById('newStudentLast').value = '';
            document.getElementById('newStudentNumber').value = '';
            renderStudentRoster();
            updateDashboard();
            showToast(`${newStudent.firstName} added!`);
        }

        function renderStudentRoster() {
            const classStudents = appData.students.filter(s => s.classId === appData.currentClassId);
            const search = document.getElementById('studentSearchInput').value.toLowerCase();
            const filtered = classStudents.filter(s => s.fullName.toLowerCase().includes(search) || s.studentId.toLowerCase().includes(search));
            
            const tbody = document.getElementById('studentTableBody');
            tbody.innerHTML = '';

            if (filtered.length === 0) {
                document.getElementById('studentTableEmpty').classList.remove('hidden');
                return;
            }
            document.getElementById('studentTableEmpty').classList.add('hidden');

            filtered.forEach(student => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td class="py-3 px-4 text-slate-600">${student.studentId}</td>
                    <td class="py-3 px-4 font-medium text-slate-800">${student.fullName}</td>
                    <td class="py-3 px-4 text-slate-600">${student.gender}</td>
                    <td class="py-3 px-4 text-right"><button onclick="deleteStudent('${student.id}')" class="text-xs text-rose-600 hover:text-rose-800 font-semibold">Delete</button></td>
                `;
                tbody.appendChild(row);
            });
        }

        function deleteStudent(id) {
            if (confirm('Remove student?')) {
                appData.students = appData.students.filter(s => s.id !== id);
                saveToStorage();
                renderStudentRoster();
                showToast('Student removed');
            }
        }

        function saveClassSettings(e) {
            e.preventDefault();
            const currentClass = getCurrentClass();
            if (!currentClass) return;
            currentClass.name = document.getElementById('setClassName').value.trim();
            currentClass.subject = document.getElementById('setClassSubject').value.trim();
            saveToStorage();
            renderClassSelect();
            updateHeaderUI();
            showToast('Settings saved!');
        }

        function confirmDeleteClass() {
            if (appData.classes.length <= 1) {
                showToast('Cannot delete only class', 'fa-solid fa-exclamation-triangle text-amber-400');
                return;
            }
            if (confirm('Delete this class and all data?')) {
                const classId = appData.currentClassId;
                appData.classes = appData.classes.filter(c => c.id !== classId);
                appData.students = appData.students.filter(s => s.classId !== classId);
                appData.currentClassId = appData.classes[0].id;
                appData.shareCode = null;
                saveToStorage();
                renderClassSelect();
                updateHeaderUI();
                showToast('Class deleted');
            }
        }

        function updateDashboard() {
            const classStudents = appData.students.filter(s => s.classId === appData.currentClassId);
            document.getElementById('dashTotalStudents').textContent = classStudents.length;
            document.getElementById('dashTotalClasses').textContent = appData.classes.length;
        }

        // --- SHARE CODE ---
        function generateAndDisplayShareCode() {
            if (!appData.shareCode) {
                appData.shareCode = generateShareCode();
                saveToStorage();
            }
            document.getElementById('shareCodeDisplay').textContent = appData.shareCode;
        }

        function copyShareCode() {
            navigator.clipboard.writeText(appData.shareCode);
            showToast('Code copied!', 'fa-solid fa-copy text-blue-400');
        }

        // --- EXPORT/IMPORT ---
        function exportDataAsJSON() {
            const currentClass = getCurrentClass();
            const classData = {
                class: currentClass,
                students: appData.students.filter(s => s.classId === appData.currentClassId)
            };
            const json = JSON.stringify(classData, null, 2);
            const blob = new Blob([json], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${currentClass.name.replace(/\s+/g, '_')}_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            showToast('Exported as JSON', 'fa-solid fa-download text-blue-400');
        }

        function exportDataAsCSV() {
            const currentClass = getCurrentClass();
            const classStudents = appData.students.filter(s => s.classId === appData.currentClassId);
            
            let csv = 'Student ID,First Name,Last Name,Gender,Date Exported\n';
            classStudents.forEach(s => {
                csv += `${s.studentId},"${s.firstName}","${s.lastName}",${s.gender},${new Date().toISOString().split('T')[0]}\n`;
            });
            
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${currentClass.name.replace(/\s+/g, '_')}_students.csv`;
            a.click();
            showToast('Exported as CSV', 'fa-solid fa-download text-emerald-400');
        }

        function handleImportData() {
            const file = document.getElementById('importFileInput').files[0];
            if (!file) {
                showToast('Select a file', 'fa-solid fa-exclamation-triangle text-amber-400');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.class && data.students) {
                        appData.students.push(...data.students);
                        saveToStorage();
                        closeModal('importDataModal');
                        renderStudentRoster();
                        updateDashboard();
                        showToast('Data imported!', 'fa-solid fa-upload text-emerald-400');
                    }
                } catch (err) {
                    showToast('Invalid file', 'fa-solid fa-circle-xmark text-rose-400');
                }
            };
            reader.readAsText(file);
        }

        // --- DEMO DATA ---
        function loadSampleData() {
            if (appData.students.filter(s => s.classId === appData.currentClassId).length === 0) {
                const names = ['John Smith', 'Jane Doe', 'Alex Johnson', 'Maria Garcia', 'Michael Chen'];
                names.forEach(name => {
                    const [firstName, lastName] = name.split(' ');
                    appData.students.push({
                        id: 'std-' + Date.now() + Math.random(),
                        classId: appData.currentClassId,
                        studentId: `STD-${Math.floor(Math.random() * 1000)}`,
                        firstName,
                        lastName,
                        fullName: name,
                        gender: Math.random() > 0.5 ? 'Male' : 'Female'
                    });
                });
            }
            saveToStorage();
            updateDashboard();
            renderStudentRoster();
            showToast('Demo data loaded!', 'fa-solid fa-wand-magic-sparkles text-purple-400');
        }

        // --- INIT ---
        window.addEventListener('load', async () => {
            await initIndexedDB();
            await loadFromStorage();
            if (appData.classes.length === 0) appData = { ...DEFAULT_STATE };
            renderClassSelect();
            updateHeaderUI();
            updateDashboard();
            generateAndDisplayShareCode();
            switchTab('dashboard');
            showToast('✨ App loaded! Data stored locally.', 'fa-solid fa-check-circle text-blue-400');
        });

        // Auto-save every 5 seconds
        setInterval(saveToStorage, 5000);
    </script>
</body>
</html>
